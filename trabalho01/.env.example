# Variáveis de Ambiente para Produção (AWS / Supabase)

# Chave secreta do Django (Gere uma chave segura em produção)
SECRET_KEY=sua_secret_key_aqui

# Em produção na AWS, mantenha False
DEBUG=False

# Hosts permitidos (separados por vírgula)
# Exemplo AWS: .amazonaws.com,meudominio.com.br
ALLOWED_HOSTS=*

# Origens confiáveis para CSRF (necessário para HTTPS em produção)
# Exemplo: https://meu-app.awsapprunner.com
CSRF_TRUSTED_ORIGINS=https://*.amazonaws.com

# Banco de Dados PostgreSQL do Supabase (para que TODO o banco do Django fique no Supabase)
# Copie do painel do Supabase: Settings -> Database -> Connection String -> URI (Modo Transaction ou Session)
# Exemplo: postgresql://postgres.[project-ref]:[sua-senha]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase API (utilizado pela página de integrantes e SDK)
SUPABASE_URL=https://rcgdynwvqfscixmhvxsj.supabase.co
SUPABASE_KEY=sb_publishable_zBH8deVG2eYdIQ5LAfg4Wg_DVqaIRcl
